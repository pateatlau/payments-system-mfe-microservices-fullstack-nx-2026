{
  "name": "shared-test-utils",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "libs/shared-test-utils/src",
  "projectType": "library",
  "tags": ["type:test-utils"],
  "targets": {
    "build": {
      "executor": "@nx/js:tsc",
      "outputs": ["{options.outputPath}"],
      "options": {
        "outputPath": "dist/libs/shared-test-utils",
        "main": "libs/shared-test-utils/src/index.ts",
        "tsConfig": "libs/shared-test-utils/tsconfig.lib.json",
        "assets": ["libs/shared-test-utils/*.md"]
      }
    },
    "test": {
      "executor": "@nx/jest:jest",
      "outputs": ["{workspaceRoot}/coverage/{projectRoot}"],
      "options": {
        "jestConfig": "libs/shared-test-utils/jest.config.js",
        "passWithNoTests": true
      }
    }
  }
}
